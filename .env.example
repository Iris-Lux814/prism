# Path to the memory vault directory (must exist and be writable)
PRISM_VAULT=./memory-vault
# Backward-compatible aliases: VAULT_PATH, TELEGRAM_MEMORY_VAULT

# DeepSeek API key — used only by the compiler (episode summarisation)
# The rest of the library works without it (no model calls)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional semantic search via local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_MS=5000
OLLAMA_EMBED_MIN_SIMILARITY=0.72
OLLAMA_EMBED_BATCH_SIZE=32

# Optional: path for lifecycle-maintenance log output
MAINTENANCE_LOG=./lifecycle-maintenance.log

# Optional lifecycle cooling thresholds. Defaults are conservative for public use.
PRISM_WARM_AFTER_DAYS=7
PRISM_COLD_AFTER_DAYS=30
PRISM_ARCHIVE_AFTER_DAYS=90
